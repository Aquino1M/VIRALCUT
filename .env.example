APP_NAME=ViralClip AI
SECRET_KEY=troque-esta-chave-em-producao
HOST=127.0.0.1
PORT=8080
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe

# auto = NVIDIA usa CUDA quando disponível; AMD/Intel usam DirectML no Windows quando instalado pelo VIRALCLIP.bat; CPU é fallback.
WHISPER_BACKEND=auto
WHISPER_MODEL=small
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=auto

# i5-4590 tem 4 cores. 3 threads deixa o PC mais responsivo no fallback CPU.
WHISPER_CPU_THREADS=3
WHISPER_NUM_WORKERS=1
WHISPER_BEAM_SIZE=1
WHISPER_CHUNK_SECONDS=60

# auto escolhe NVENC (NVIDIA), AMF (AMD), QSV (Intel) ou libx264 conforme o computador.
VIDEO_ENCODER=auto
MAX_UPLOAD_MB=10240

# Opcional: LLM OpenAI-compatible (OpenAI, LM Studio, vLLM, etc.)
# Exemplo LM Studio: http://localhost:1234/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=120

# Opcional: provedores extras para ampliar a Biblioteca Leve. Sem chaves, o pacote usa fontes sem chave compatíveis.
PEXELS_API_KEY=
PIXABAY_API_KEY=
VIRALCLIP_ASSET_PACK=lite

# Futuro frontend Vercel: allowlist CORS explícita, separada por vírgulas. Nunca use *.
# Ex.: WORKER_ALLOWED_ORIGINS=https://seuapp.vercel.app,https://app.seudominio.com
WORKER_ALLOWED_ORIGINS=

# V3.4 Performance Engine
ASR_CACHE_MAX_GB=8


# V4.2 Adaptive Compute Fabric — opcional. Somente CPU grátis da Lightning.
# NUNCA configure URL de worker em GPU/T4 nesta build; o app rejeita.
LIGHTNING_ENABLED=0
LIGHTNING_CLOUD_URL=
LIGHTNING_CLOUD_TOKEN=
LIGHTNING_TIMEOUT=120
LIGHTNING_UPLOAD_CHUNK_MB=16
COMPUTE_MODE=auto
# Optional: absolute path to a protected Netscape cookies.txt file mounted only
# on the processing worker. Never commit this file or paste its contents here.
YTDLP_COOKIES_FILE=
# Base64 of a protected Netscape cookies.txt session. Suitable for Railway
# variables; do not use a primary Google account and never commit the value.
YTDLP_COOKIES_B64=
# Private URL of the BgUtils PO Token provider for hosted YouTube imports.
YTDLP_BGUTIL_BASE_URL=
CLOUD_MEDIA_RETENTION_HOURS=24
CLOUD_RESULT_RETENTION_DAYS=7
